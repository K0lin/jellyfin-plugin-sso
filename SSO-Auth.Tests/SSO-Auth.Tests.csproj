<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <!-- The plugin excludes the Jellyfin runtime assets (the server provides them); a test host has no server. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Common" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Data" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SSO-Auth\SSO-Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\SSO-Auth\Config\i18n\*.json">
      <Link>i18n\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
